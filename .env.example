# Envoi des formulaires — serveur SMTP de la messagerie du club (o2switch).
# À reporter dans Vercel > Settings > Environment Variables (Production + Preview).
# Ces variables n'ont PAS le préfixe NEXT_PUBLIC_ : elles restent côté serveur
# et ne sont jamais visibles dans le navigateur.

SMTP_HOST=lacanau-ocehand.fr
SMTP_PORT=465
SMTP_USER=site@lacanau-ocehand.fr
SMTP_PASSWORD=le-mot-de-passe-de-cette-boite

# Facultatif : expéditeur affiché (sinon SMTP_USER)
# MAIL_FROM=Site Lacanau Océhand <site@lacanau-ocehand.fr>

# Facultatif : destinataire (sinon contact@lacanau-ocehand.fr)
# CONTACT_TO=contact@lacanau-ocehand.fr

# Envoi des formulaires — serveur SMTP de la messagerie du club.
# À reporter dans Vercel > Settings > Environment Variables (Production + Preview).
# Ces variables n'ont PAS le préfixe NEXT_PUBLIC_ : elles restent côté serveur
# et ne sont jamais visibles dans le navigateur.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=adresse-complete@gmail.com

# ⚠️ PAS le mot de passe du compte Google : Gmail le refuse depuis 2022.
# Générer un « mot de passe d'application » sur myaccount.google.com/apppasswords
# (validation en deux étapes obligatoire) et le saisir SANS les espaces.
SMTP_PASSWORD=motdepassedapplication16car

# Facultatif : expéditeur affiché (sinon SMTP_USER)
# MAIL_FROM=Site Lacanau Océhand <adresse-complete@gmail.com>

# Facultatif : destinataire (sinon la valeur par défaut du code)
# CONTACT_TO=adresse-complete@gmail.com


# ============================================================
# ESPACE D'ADMINISTRATION — /admin
# ============================================================

# Code d'accès à l'espace d'administration.
# Sans cette variable, le code par défaut du club s'applique.
# La définir sur Vercel permet de le changer sans toucher au code.
# ADMIN_CODE=LacanauOcehand123

# Clé de signature des sessions d'administration. Facultative : elle est
# dérivée du code d'accès si elle est absente. La définir (n'importe quelle
# chaîne longue et aléatoire) permet de changer le code sans déconnecter
# tout le monde, et inversement.
# ADMIN_SESSION_SECRET=une-longue-chaine-aleatoire

# Stockage des modifications faites depuis /admin.
# ⚠️ NE PAS SAISIR À LA MAIN : sur Vercel, aller dans Storage → Create
# Database → Blob, puis « Connect » vers ce projet. La variable est alors
# ajoutée automatiquement à tous les environnements ; il ne reste qu'à
# redéployer. Sans elle, /admin fonctionne en local mais reste en lecture
# seule en ligne.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx_yyyyyyyy

# Facultatif : forcer l'URL publique du fichier de contenu. Utile seulement
# si l'adresse déduite du jeton ne correspondait pas.
# BLOB_CONTENT_URL=https://xxxxxxxx.public.blob.vercel-storage.com/contenu/site-content.json
